FoamFile {version 2.0; format ascii; class dictionary; object fvSolution;}
solvers
{
 p {solver GAMG; tolerance 1e-8; relTol .05; smoother GaussSeidel; cacheAgglomeration true; agglomerator faceAreaPair; nCellsInCoarsestLevel 20; mergeLevels 1;}
 "(U|k|omega)" {solver smoothSolver; smoother symGaussSeidel; tolerance 1e-8; relTol .1;}
}
SIMPLE {nNonOrthogonalCorrectors 2; consistent no; nUCorrectors 2; residualControl {p 1e-6; U 1e-6; k 1e-6; omega 1e-6;}}
relaxationFactors {fields {p .15;} equations {U .4; k .4; omega .4;}}
